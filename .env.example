# Salin berkas ini menjadi ".env" lalu isi sesuai kebutuhan.

# Port server berjalan
PORT=3000

# Rahasia sesi login admin - ganti dengan teks acak yang panjang
SESSION_SECRET=ganti-dengan-teks-rahasia-yang-panjang-dan-acak

# Akun admin default (hanya dipakai saat database masih kosong / pertama kali dijalankan)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Konfigurasi SMTP untuk fitur "Kirim Email" di panel admin (opsional)
# Contoh untuk Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
# Gunakan App Password, jangan password akun utama.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Set "true" jika server sudah berjalan di balik HTTPS
FORCE_HTTPS=false
NODE_ENV=production
